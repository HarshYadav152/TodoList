NODE_ENV=development
PORT=3001

# Local dev default matches docker-compose.yml in this folder.
MONGO_URI=mongodb://localhost:27017/todolist

# Must match the Vite dev server origin exactly (scheme + host + port).
FRONTEND_URL=http://localhost:5173

# Generate real secrets for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Run `npm run generate:vapid` and paste the output here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
